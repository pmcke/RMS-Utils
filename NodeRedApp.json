    {
        "id": "1984fb125f0c1406",
        "type": "function",
        "z": "793d83fb15a6a9ba",
        "name": "Format Data",
        "func": "// Expecting msg.payload as an array of { time, value, topic }\nlet data = msg.payload || [];\n\n// Read daytime flag (set by your time-range + Change nodes)\nconst isDaytime = flow.get(\"daytime\") === true;\n\n// Extract alphanumeric camera ID (e.g. NZ0014, NZ001P, NZ002K)\nfunction extractCameraID(topic) {\n    let match = topic?.match(/nz[0-9a-z]+/i);\n    return match ? match[0].toUpperCase() : (topic || \"UNKNOWN\");\n}\n\nlet grouped = {};\nlet latestGlobalTime = 0;\n\nfor (let entry of data) {\n    if (!entry) continue;\n\n    const id = extractCameraID(entry.topic);\n    const t  = new Date(entry.time).getTime();\n    let val  = Number(entry.value_num);\n\n    if (!Number.isFinite(val) || !Number.isFinite(t)) continue;\n\n    // 🔸 Force starcount to 0 during daytime\n    // (only when the metric is starcount; other metrics unaffected)\n    if (isDaytime && /\\/starcount$/i.test(entry.topic)) {\n        val = 0;\n    }\n\n    if (!grouped[id]) grouped[id] = { sum: 0, count: 0, latestVal: val, latestTime: t };\n\n    grouped[id].sum += val;\n    grouped[id].count += 1;\n\n    if (t > grouped[id].latestTime) {\n        grouped[id].latestVal = val;\n        grouped[id].latestTime = t;\n    }\n    if (t > latestGlobalTime) latestGlobalTime = t;\n}\n\n// Prepare chart data arrays\nconst labels   = Object.keys(grouped).sort();\nconst averages = labels.map(id => grouped[id].count ? grouped[id].sum / grouped[id].count : 0);\nlet latests    = labels.map(id => grouped[id].latestVal);\n\n// Format for Node-RED bar chart\nmsg.payload = [{\n    series: ['Average (1h)', 'Latest value'],\n    data: [averages, latests],\n    labels: labels\n}];\n\n// Extra info for debugging / dashboard text node\nmsg.lastUpdate = latestGlobalTime ? new Date(latestGlobalTime).toLocaleString() : '';\nmsg.daytime = isDaytime;\n\nreturn msg;\n",
