    {
        "id": "b4c65f3b2557030d",
        "type": "function",
        "z": "e881957e79a14179",
        "name": "Format Data",
        "func": "// --- Node-RED Function: Format camera/time array for dashboard ---\n\nlet data = msg.payload;\nlet lines = [];\n\n// Case 1: payload is an array of objects\nif (Array.isArray(data)) {\n    for (let item of data) {\n        // Extract topic and value safely\n        let topic = \"\";\n        let value = \"\";\n\n        // Some nodes use \"topic\" + \"payload\", others \"topic\" + \"value\"\n        if (typeof item === \"object\") {\n            topic = item.topic || \"\";\n            value = item.value || item.payload || \"\";\n        } else {\n            // If it's not an object, just stringify it\n            lines.push(String(item));\n            continue;\n        }\n\n        // Extract NZ-code (e.g. meteorcams/nz0014/... → NZ0014)\n        let match = topic.match(/nz[0-9a-z]+/i);\n        let cam = match ? match[0].toUpperCase() : topic;\n\n        // Add formatted line\n        lines.push(`${cam} – ${value}`);\n    }\n}\n\n// Case 2: if payload is already a string (fallback)\nelse if (typeof data === \"string\") {\n    lines = data\n        .replace(/<br\\s*\\/?>/gi, \"\\n\")\n        .split(\"\\n\")\n        .filter(l => l.trim() !== \"\");\n}\n\n// Combine everything nicely\nmsg.payload = lines.join(\"\\n\");\n\nreturn msg;\n\n",
